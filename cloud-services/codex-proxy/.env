# Codex CLI base URL (without /v1/responses)
CODEX_API_BASE=https://chat.nuoda.vip/codex

# Codex CLI API key
CODEX_API_KEY=add_your_codex_api_key_here

# Proxy upstream endpoint (Responses API complete URL)
BASE_URL=https://chat.nuoda.vip/codex/v1/responses

# Proxy API key (kept same as Codex key by default)
API_KEY=sk-add_your_codex_api_key_here

# Local proxy listen port
LOCAL_PORT=18801

# Models listed in /v1/models
MODELS=gpt-5-codex,gpt-5,gpt-5.4,gpt-5.1,gpt-5.2
